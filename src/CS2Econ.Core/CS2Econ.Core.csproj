<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure economy core. MUST NOT reference any game or Unity assembly (PLAN §1:
       ports-and-adapters). netstandard2.1 target keeps it loadable by the game's
       Mono runtime; net8.0 target is used by the out-of-game harness. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.1</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
