<Project Sdk="Microsoft.NET.Sdk">

  <!-- Standalone harness (PLAN §4): correctness suite, §6 acceptance scenarios,
       and the vanilla-baseline A/B. Never links the game or CS2Path. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPgo>true</TieredPgo>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../CS2Econ.Core/CS2Econ.Core.csproj" />
    <!-- The mod project, in its OUT_OF_GAME_BUILD configuration: every game
         touchpoint compiles as a stub, so this links no Colossal Order code and
         the rule above still holds. Three classes in CS2Econ.Mod are compiled
         OUTSIDE the #if precisely so the harness can pin them — EconAssess
         ("compiled in both builds so the harness can pin it"), EconSeams ("the
         system-disable seam as DATA … harness-testable") and EconSiteLink — and
         until this reference existed, nothing could. ModSiteLink.cs is the
         first fixture to use it; the other two remain unpinned. -->
    <ProjectReference Include="../CS2Econ.Mod/CS2Econ.Mod.csproj" />
  </ItemGroup>

</Project>
