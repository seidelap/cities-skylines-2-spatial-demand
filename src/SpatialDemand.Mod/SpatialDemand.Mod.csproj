<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SpatialDemand</AssemblyName>
    <Version>0.5.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <PublishConfigurationPath>Properties/PublishConfiguration.xml</PublishConfigurationPath>
    <CSIIToolPath Condition="'$(CSIIToolPath)' == ''">$(CSII_TOOLPATH)</CSIIToolPath>
    <CSIIToolPath Condition="'$(CSIIToolPath)' == '' and '$(OS)' == 'Windows_NT'">$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'User'))</CSIIToolPath>
  </PropertyGroup>
  <Import Project="$(CSIIToolPath)/Mod.props" Condition="Exists('$(CSIIToolPath)/Mod.props')" />
  <Import Project="$(CSIIToolPath)/Mod.targets" Condition="Exists('$(CSIIToolPath)/Mod.targets')" />
  <!-- Override only the official copy step. Compilation and postprocessing remain official.
       Fail closed: neither a plain build nor an ignored staging argument may install. -->
  <Target Name="SpatialDemandDeploymentPlan" DependsOnTargets="BuildGetFullPaths">
    <Error Condition="'$(SpatialDemandStageDirectory)' != '' and '$(SpatialDemandAllowInstall)' == 'true'"
           Text="Choose staging or installation, not both." />
    <PropertyGroup>
      <SpatialDemandDestination>$(SpatialDemandStageDirectory)</SpatialDemandDestination>
      <SpatialDemandDestination Condition="'$(SpatialDemandAllowInstall)' == 'true'">$(DeployDir)</SpatialDemandDestination>
    </PropertyGroup>
    <Error Condition="'$(SpatialDemandDestination)' == ''"
           Text="Use tools/build-windows.ps1, or explicitly supply SpatialDemandStageDirectory or SpatialDemandAllowInstall=true." />
    <Error Condition="'$(SpatialDemandDestination)' == '$(DeployDir)' and '$(SpatialDemandAllowInstall)' != 'true'"
           Text="Staging must not use the installed game mod directory." />
  </Target>
  <Target Name="DeployWIP" AfterTargets="AfterBuild" DependsOnTargets="SpatialDemandDeploymentPlan" Condition="'$(NeedBuild)'">
    <ItemGroup>
      <SpatialDemandDeployFiles Include="$(OutDir)\**\*.*" />
    </ItemGroup>
    <Message Text="Copy mod output to verified destination $(SpatialDemandDestination)" Importance="high" />
    <RemoveDir Directories="$(SpatialDemandDestination)" Condition="'$(SpatialDemandAllowInstall)' == 'true'" />
    <Copy SourceFiles="@(SpatialDemandDeployFiles)"
          DestinationFiles="@(SpatialDemandDeployFiles->'$(SpatialDemandDestination)\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  <ItemGroup>
    <!-- The installed Burst postprocessor cannot hash the merged 2.4.2 assembly. -->
    <PackageReference Include="Lib.Harmony" Version="2.2.2" />
    <None Include="../../licenses/Harmony-LICENSE.txt" Link="Harmony-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Compile the same tested core into the mod; Harmony is the only runtime dependency. -->
    <Compile Include="../SpatialDemand.Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Reference Include="Game" Private="false" />
    <Reference Include="Colossal.Core" Private="false" />
    <Reference Include="Colossal.Logging" Private="false" />
    <Reference Include="Colossal.IO.AssetDatabase" Private="false" />
    <Reference Include="Colossal.Localization" Private="false" />
    <Reference Include="Colossal.Mathematics" Private="false" />
    <Reference Include="Colossal.Collections" Private="false" />
    <Reference Include="Unity.Entities" Private="false" />
    <Reference Include="Unity.Collections" Private="false" />
    <Reference Include="Unity.Mathematics" Private="false" />
    <Reference Include="UnityEngine.CoreModule" Private="false" />
  </ItemGroup>
  <Target Name="RequireGameToolchain" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(CSIIToolPath)/Mod.props') or !Exists('$(CSIIToolPath)/Mod.targets')"
           Text="The actual mod requires the Cities: Skylines II modding toolchain. Install it through the game, then set CSII_TOOLPATH or pass -p:CSIIToolPath=... . For portable tests, build tests/SpatialDemand.Tests instead. There is no stub mod build." />
  </Target>
  <Target Name="RecordResolvedGameAssembly" AfterTargets="ResolveAssemblyReferences">
    <PropertyGroup>
      <GameAssemblyRecordPath Condition="'$(GameAssemblyRecordPath)' == ''">$(IntermediateOutputPath)game-assembly-path.txt</GameAssemblyRecordPath>
    </PropertyGroup>
    <ItemGroup>
      <ResolvedGameAssembly Include="@(ReferencePath)" Condition="'%(ReferencePath.Filename)' == 'Game'" />
    </ItemGroup>
    <WriteLinesToFile File="$(GameAssemblyRecordPath)" Lines="@(ResolvedGameAssembly->'%(FullPath)')" Overwrite="true" />
  </Target>
</Project>
